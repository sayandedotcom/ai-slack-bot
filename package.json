{
  "name": "firefighter",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "format:check": "biome ci .",
    "check:text": "node apps/worker/scripts/check-text-files.mjs",
    "capabilities:dts:check": "pnpm --filter @workspace/worker capabilities:dts:check",
    "check": "pnpm run check:text && pnpm run lint && pnpm run typecheck && pnpm run capabilities:dts:check && pnpm run test",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@workspace/typescript-config": "workspace:*",
    "husky": "^9.1.7",
    "turbo": "^2.10.12",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.20.0"
  }
}
