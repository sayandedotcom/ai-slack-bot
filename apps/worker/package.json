{
  "name": "@workspace/worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "pnpm --filter @workspace/dashboard build && wrangler deploy",
    "test": "node scripts/check-text-files.mjs && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "capabilities:dts": "node --import ./scripts/capabilities-node-shim.mjs --import tsx scripts/generate-capabilities-dts.ts --write",
    "capabilities:dts:check": "node scripts/check-text-files.mjs && node --import ./scripts/capabilities-node-shim.mjs --import tsx scripts/generate-capabilities-dts.ts --check",
    "cf-typegen": "wrangler types --strict-vars=false",
    "check:text": "node scripts/check-text-files.mjs",
    "profile": "node scripts/profile.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.44",
    "@cloudflare/codemode": "0.5.1",
    "@cloudflare/sandbox": "0.12.5",
    "@cloudflare/think": "0.15.1",
    "@getzep/zep-cloud": "^3.27.0",
    "agents": "0.20.1",
    "ai": "^7.0.83",
    "drizzle-orm": "0.45.2",
    "hono": "^4.13.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.0",
    "@types/json-schema": "7.0.15",
    "@workspace/dashboard": "workspace:*",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.0",
    "wrangler": "^4.120.0"
  }
}
