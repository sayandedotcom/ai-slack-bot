{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "firefighter",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // The memory-outbox recovery sweep (Phase 10 Task 9, Step 5).
  //
  // Every minute, `scheduled()` re-enqueues a BOUNDED page of due D1
  // `pending | retry | expired-projecting` agent_memory_outbox rows. It is the
  // backstop for the two delivery paths that can be lost entirely: a RunDO
  // alarm that never fires again, and a queue message that exhausted its
  // retries and went to the DLQ. The D1 row outlives both.
  //
  // One minute rather than something rarer because memory lag compounds: a run
  // that answers using a graph missing yesterday's episodes is worse than a
  // slightly busier cron. The sweep is one indexed SELECT and at most a page of
  // queue sends, and it never touches a customer-facing answer.
  "triggers": { "crons": ["* * * * *"] },
  // Non-secret pins for Phase 09 capabilities. These are IDs and hostnames, not
  // credentials — they live here rather than in .dev.vars so that a reviewer can
  // confirm what the capability layer is scoped to by reading the diff.
  "vars": {
    // Better Stack SQL API host. Region-scoped: this endpoint only resolves
    // sources in eu-central-1a. Credentials are BETTERSTACK_SQL_* secrets.
    "BETTERSTACK_SQL_ENDPOINT": "https://eu-central-1a-connect.betterstackdata.com",
    // Allowlist of queryable log collections (Task 11 Step 1). Comma-separated
    // ClickHouse collection names; betterstack.logs() names one of these as a
    // literal and binds everything else as a parameter.
    //
    // The `_logs` suffix is load-bearing: `t582255_firefighter_worker` is the
    // SOURCE name, not a queryable collection, and resolves as
    // CLUSTER_DOESNT_EXIST. The hot-storage collection is the one below;
    // `_metrics` and `_s3` are the other two the source exposes.
    "BETTERSTACK_LOG_SOURCE_IDS": "t582255_firefighter_worker_logs",
    // Linear team the agent may file into (Task 8, decision D4). LINEAR_API_KEY
    // is NOT scoped to this team -- it can reach all five workspace teams,
    // including Development. This pin is the only thing that stops it, so the
    // team id must never come from the caller. The name is here purely so a
    // reviewer can confirm the pin without resolving the uuid.
    "LINEAR_TEAM_ID": "3b7d3585-029d-4490-80ce-6a44c6d9f081",
    "LINEAR_TEAM_NAME": "fire-fighter-testing",
    // LangSmith read surface (Task 10 Step 1), pinned server-side for the same
    // reason as the Linear team: LANGSMITH_API_KEY is workspace-wide, so the
    // project must never come from the caller.
    "LANGSMITH_ENDPOINT": "https://api.smith.langchain.com",
    "LANGSMITH_WORKSPACE_ID": "d81d9ce6-2548-465e-bd56-72e2f97a1f19",
    "LANGSMITH_PROJECT_ID": "647f1d2e-bb76-48b3-adad-1d196ca0debe",
    "LANGSMITH_PROJECT_NAME": "tweakleaf",
    // Supabase PostgREST origin (Task 9). Fixed server-side so the reader can
    // never be pointed at another project. Credential is SUPABASE_KEY.
    "SUPABASE_URL": "https://uahmoigkzsuwhheohitz.supabase.co",
    // Where a published artifact is fetched from. The Worker's own origin, not
    // an R2 public bucket URL -- see the r2_buckets comment below.
    "ARTIFACTS_BASE_URL": "https://firefighter.sayandeten.workers.dev/api/artifacts",
    // Where a proof recording is fetched from (Phase 19). Top level, NOT under
    // /api, because this path needs a Cloudflare Access BYPASS policy: Slack's
    // unfurler carries no Access token. See src/api/proofs.ts.
    "PROOFS_BASE_URL": "https://firefighter.sayandeten.workers.dev/proofs",
    // Cloudflare Access, fronting the dashboard (Phase 11 Task 2). Non-secret:
    // both values are read out of a validated JWT's own claims, not used to
    // authenticate anything themselves. See src/access/jwt.ts.
    "ACCESS_TEAM_DOMAIN": "zellify-firefighter.cloudflareaccess.com",
    // The AUD tag of the `firefighter - Dashboard` self-hosted Access
    // application (Phase 11 Task 10; this closes release gate G1, see
    // docs/superpowers/plans/phase-11-notes.md). That application covers the
    // bare host `firefighter.sayandeten.workers.dev` under the policy
    // "Zellify staff + temporary personal override", 24-hour session, and it
    // is the only one of the three sibling applications that gates an
    // approval route.
    //
    // Picking the right sibling is the whole risk here: the other two match
    // `/oauth` and `/slack` with bypass-for-everyone policies, so pinning
    // either of THEIR AUDs would make the verifier accept a token minted for
    // an application that authenticates nobody. `makeAccessVerifier` checks
    // `aud` unconditionally, which is what turns that distinction into a
    // real gate rather than a comment.
    //
    // Non-secret, like the team domain above: an AUD identifies which
    // application a token was minted for, it does not authorize anything by
    // itself. Never replace this with a fallback that skips the check.
    "ACCESS_APP_AUD": "1adc17dda313762e35bb55101cd87594cbc6f300d676f668fc6994f5caba8238",
    // The engineer nudge (Phase 13). All three are non-secret — a mode flag, a
    // channel id and this Worker's own origin. The credential the nudge spends
    // is SLACK_BOT_TOKEN, which stays a secret and is used in exactly two
    // places: the nudge DM and the chat.update that rewrites it once the card
    // is settled. No customer-facing message may ever take that token.
    //
    // "dm" opens a direct message with whoever is on duty; "channel" posts an
    // @-mention into NUDGE_FALLBACK_CHANNEL_ID instead. The flag exists because
    // the Slack app's `im:write` scope was an open question (roadmap line 398)
    // and both paths are implemented, so switching is a config change and not
    // a deploy of new code.
    "NUDGE_MODE": "dm",
    // The #eng-firefighter channel id, used in "channel" mode AND whenever the
    // on-duty engineer has no Slack identity row — fallback beats silence.
    //
    // Set to `ff-test` by the operator, 2026-08-14. No dedicated
    // #eng-firefighter channel exists in this workspace; ff-test is the
    // developer's own sandbox, and the drill runs in test-firedrill, so the
    // graded channel stays free of internal traffic.
    //
    // Two things make this safe rather than merely convenient. A nudge posted
    // here cannot wake anything: ingest drops `bot_id`/`bot_message` before the
    // queue (src/ingest/rules.ts), so there is no nudge → triage → nudge loop.
    // And an empty value was never a broken state: `sendNudge` checks this
    // BEFORE taking the once-only claim, so an unaddressable nudge stays on the
    // sweeper's retry feed instead of burning the slot.
    //
    // The residual trade-off, recorded rather than hidden: ff-test is a
    // `mode=live` customer channel, so a fallback nudge shows an UNAPPROVED
    // draft in a channel the agent also replies into. Acceptable only because
    // no real customer is in it. Point this at a genuinely internal channel
    // before this system sees a real customer workspace.
    "NUDGE_FALLBACK_CHANNEL_ID": "C0BPA2L4BBP",
    // Where the nudge's "Review" button points: `${DASHBOARD_BASE_URL}/?approval=${id}`.
    // The Worker's own origin — the dashboard is served from it (see "assets").
    "DASHBOARD_BASE_URL": "https://firefighter.sayandeten.workers.dev",
    // How ingest recognises this app's OWN user-token posts (agent replies sent
    // as the on-duty engineer). Slack stamps bot_id + app_id on every
    // API-posted message, so without these two pins the blanket bot drop erased
    // the agent's replies from D1 (found live, 2026-08-14). Both are public
    // identifiers, not credentials: they appear in every message the app posts.
    // app_id from the app's own settings URL; bot user id from auth.test.
    "SLACK_APP_ID": "A0BPVS02D1N",
    "SLACK_BOT_USER_ID": "U0BNZGM7422",
    // --------------------------------------------------------- Phase 18
    //
    // The Tier 2 sandbox. All three are non-secret by construction: a path
    // inside a container, a hostname that resolves nowhere, and a duration.
    // The two secrets this phase adds (MONOREPO_PAT, MONOREPO_DEV_ENV) are
    // `wrangler secret put`, and no value of either appears in this repo.

    // Where the baked image puts the monorepo checkout. Must match the
    // Dockerfile's clone target; the model reads it, it never chooses it.
    "SANDBOX_REPO_PATH": "/workspace/web2app-rebuild",

    // The sentinel host the container's git remote points at. It resolves
    // nowhere on purpose: it exists so that exactly ONE hostname enters Worker
    // fetch, where `Sandbox.outboundByHost` (src/sandbox/class.ts) rewrites it
    // to github.com and attaches the real PAT. The container is handed a
    // placeholder and never holds a credential it could leak.
    //
    // Registering only this host keeps the SDK in per-host interception mode,
    // so R2, npm, apt — and github.com reached directly — flow through the
    // container's own network namespace and never touch Worker fetch. That is
    // load-bearing, not tidiness: Worker fetch normalizes Content-Length on
    // HEAD responses, which broke agent-os's s3fs-on-R2 mount.
    //
    // This value is DUPLICATED as GIT_SENTINEL_HOST in src/sandbox/class.ts,
    // because `static outboundByHost` is a hostname-keyed registry the SDK
    // reads at DO construction, with no `env` in scope. `assertGitSentinel()`
    // throws if the two ever drift.
    "SANDBOX_GIT_HOST": "git.firefighter.local",

    // The idle backstop, never the plan — teardown is what destroys a
    // container (Task 4). The SDK's default is 10 minutes, which is shorter
    // than a monorepo install plus a build, and a container that naps
    // mid-repro reads as a hang to the human watching the Slack thread.
    "SANDBOX_SLEEP_AFTER": "45m",

    // Phase 20's GitHub ship config (Task 3). Non-secret, same discipline as
    // LINEAR_TEAM_ID above: the repo and base branch pin themselves
    // server-side rather than trusting a caller. GITHUB_HEAD_REPO is
    // deliberately unset -- it defaults to GITHUB_REPO, so head pushes and PR
    // opens target the same repo until a fork is actually in play.
    "GITHUB_REPO": "Zellify/web2app-rebuild",
    "GITHUB_BASE": "staging",
    "GITHUB_AUTHOR": "worker-pat"
  },
  "assets": {
    // The dashboard's Vite build output (Phase 14). It replaced ./public, which
    // held one placeholder index.html. `dist` is gitignored, so a fresh
    // checkout must build it before `wrangler dev`, `wrangler deploy` or the
    // test pool will find it -- which is why @workspace/dashboard is a
    // devDependency of this package (turbo's `build` dependsOn `^build`) and
    // why the deploy script builds it explicitly.
    "directory": "../dashboard/dist",
    "binding": "ASSETS",
    // Without this the asset worker runs first and the Worker only sees requests
    // that miss an asset. src/index.ts owns the routing instead: it answers /api/*
    // and explicitly falls through to ASSETS for everything else.
    "run_worker_first": true,
    // The SPA has client-side paths that no file matches. Without this, a hard
    // refresh on one of them 404s from the asset worker instead of returning
    // index.html and letting the router take it.
    "not_found_handling": "single-page-application"
  },
  // Artifact storage for files.publish (Phase 09 Task 12). PRIVATE: the bucket
  // has no public origin, and objects are served only through the Worker's own
  // /api/artifacts/ route, behind whatever guards the app. Customer and
  // production debug output must not become world-readable by default.
  //
  // Phase 19's proof recordings, if they need public links, get their own
  // prefix or bucket and a deliberate decision -- not this one widened.
  //
  // That decision is now MADE, and it went the way this comment asked. Proof
  // recordings live under the `proofs/` prefix in this same bucket and are
  // served by a SECOND route, /proofs/:key (src/api/proofs.ts), which is
  // mounted at the top level so Cloudflare Access can bypass it. Nothing about
  // /api/artifacts moved: its allowlist, its 5MB cap, its `attachment`
  // disposition and its Access gate are all unchanged, and the two key spaces
  // are disjoint by shape (`<hex>.<ext>` at the root, `proofs/<hex>.mp4`,
  // `_internal/...`). The bucket still has no public origin -- what is public
  // is one Worker route, and only for keys nobody can guess.
  //
  // Access is a binding, never S3 REST keys, so there is no credential here.
  "r2_buckets": [
    { "binding": "ARTIFACTS", "bucket_name": "firefighter-artifacts" }
  ],
  // Worker Loader (Dynamic Workers, open beta since 2026-03-24). Unlike most
  // bindings this points at no external resource -- it just exposes the loader
  // API as env.LOADER. Shape verified against this repo's
  // node_modules/wrangler/config-schema.json (RawConfig.properties.worker_loaders).
  //
  // Phase 09 loads model-authored code through it with globalOutbound: null.
  // Deliberately no service binding, no outbound fetcher, no second Worker: the
  // isolate's only reach is RPC capabilities passed as call arguments.
  "worker_loaders": [{ "binding": "LOADER" }],
  // One Durable Object class, keyed by the run's origin key. `new_sqlite_classes`
  // (not `new_classes`) is what makes ctx.storage.sql available; the legacy
  // `migrations` array is used over the newer declarative `exports` map because
  // the official Vitest recipe and spikes/worker-loader both use it. See
  // docs/superpowers/plans/phase-08-notes.md.
  // The Tier 2 sandbox (Phase 18). One container per run, keyed `run:{runId}`,
  // provisioned from a fully baked image — repo pre-cloned at `staging`,
  // `pnpm install` done, `pnpm build-packages` output present, Chromium ready.
  //
  // `image` is resolved RELATIVE TO THIS CONFIG FILE, which is why the
  // Dockerfile lives under apps/worker/ rather than at the repo root.
  //
  // standard-4 = 4 vCPU / 12 GiB / 20 GB disk, the largest predefined type
  // (confirmed against containers/platform-details/limits, 2026-08-11). It is
  // not generous: `apps/dashboard`'s dev script alone asks for a 6 GB heap, so
  // exactly one such server fits at a time.
  //
  // max_instances 3 = three concurrent runs may hold a machine. The ceiling is
  // budget, not capability: container-hours are the most expensive thing this
  // system can spend, and `sleepAfter` is only the backstop — teardown on
  // terminal status and the orphan sweeper are what actually reclaim them.
  "containers": [
    {
      "class_name": "Sandbox",
      // Was "./sandbox/Dockerfile" (wrangler builds it). Now a PRE-BUILT image
      // referenced by digest, because the Dockerfile bakes the monorepo behind a
      // BuildKit --secret (the PAT) and `wrangler deploy` cannot pass a build
      // secret. Built and pushed via sandbox/build.sh, which proves no
      // credential reached a layer. Bump this digest when you rebuild the image.
      "image": "registry.cloudflare.com/cdf27b547d94db5a7bb2f42b13c5319b/firefighter-sandbox@sha256:27fd1043bd25af554f770d4656eec08e2a31352f4ab637e64ea26f34bad51a80",
      "instance_type": "standard-4",
      "max_instances": 3,
      // Operator SSH from the Cloudflare dashboard, for exactly one purpose:
      // when boot wedges with no output, the only alternative diagnostic is
      // redeploy-and-reproduce, which burned an evening on 2026-08-14. This is
      // a dashboard-authenticated door for the operator, not a container
      // capability — nothing inside the container or the model's surface can
      // reach it, and it holds no credential the container didn't already have.
      "ssh": { "enabled": true }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "RUNS", "class_name": "RunDO" },
      // A container IS a Durable Object — `@cloudflare/sandbox`'s Sandbox
      // extends Container extends DurableObject, and this binding is how the
      // Worker addresses one. The model can never name an id: the lifecycle
      // derives it from the run.
      { "name": "SANDBOX", "class_name": "Sandbox" }
    ]
  },
  // APPENDED, never edited. `v1` is RunDO's and is already applied in
  // production; rewriting an applied tag is how you lose a Durable Object's
  // storage. A new class gets a new tag.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RunDO"] },
    { "tag": "v2", "new_sqlite_classes": ["Sandbox"] }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "firefighter",
      "database_id": "bbd12fae-0c81-4efc-800e-63669fc4905c",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "INGEST_QUEUE", "queue": "firefighter-ingest" },
      { "binding": "MEMORY_QUEUE", "queue": "firefighter-memory" },
      { "binding": "TRIAGE_QUEUE", "queue": "firefighter-triage" }
    ],
    "consumers": [
      {
        "queue": "firefighter-ingest",
        "max_batch_size": 25,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "firefighter-ingest-dlq"
      },
      {
        "queue": "firefighter-memory",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "firefighter-memory-dlq"
      },
      {
        "queue": "firefighter-triage",
        "max_batch_size": 5,
        "max_batch_timeout": 3,
        "max_retries": 3,
        "dead_letter_queue": "firefighter-triage-dlq"
      }
    ]
  }
}
