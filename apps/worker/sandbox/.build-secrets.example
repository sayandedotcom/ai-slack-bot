# Build-time secrets for the sandbox image. Copy to `.build-secrets` and fill in.
#
# These are consumed by `docker build --secret` (see build.sh) and never by the
# running Worker, which is why they are not in .dev.vars. `.build-secrets` is
# gitignored; this example file carries names only, never values.
#
#   source apps/worker/sandbox/.build-secrets && ./apps/worker/sandbox/build.sh

# Fine-grained PAT, Zellify/web2app-rebuild, Contents: read-only.
# Requires org approval before it works — a pending token authenticates as you
# (200 on /user) but 404s on the repo, which reads like a scope mistake and is
# not one.
export MONOREPO_PAT=

# nucleo-ui-outline-18's preinstall verifies this. Without it a full
# `pnpm install` of the monorepo fails, so the image cannot bake.
export NUCLEO_LICENSE_KEY=
