# Copy to .env.local. Names only — never commit a value.

# "1" serves every screen from lib/fixtures and never touches the network.
# This is what a Vercel preview should run on until BACKEND-GAPS.md §1 is
# answered, because a live deployment currently 401s on every request.
NEXT_PUBLIC_DEMO=1

# Origin of the Worker, no trailing slash, e.g. https://firefighter.example.workers.dev
# next.config.ts rewrites /api/* and /proofs/* here, so the browser only ever
# sees one origin and no backend URL reaches the bundle. Ignored when
# NEXT_PUBLIC_DEMO=1.
WORKER_ORIGIN=

# Origin of the Worker again, but PUBLIC and for the run socket only.
# Next's rewrites proxy HTTP and do not carry a WebSocket upgrade, so the run
# transcript at /runs/:id must address the Worker's own host. Leave empty when
# this app is served from the Worker's origin (the socket then resolves against
# window.location) or when NEXT_PUBLIC_DEMO=1 (no socket is opened at all).
# e.g. https://firefighter.example.workers.dev
NEXT_PUBLIC_WORKER_ORIGIN=

# LOCAL ONLY, and never on Vercel. A Cloudflare Access user token, which lets
# `next dev` reach the real Worker through Access — see proxy.ts. Access
# verifies it and injects the `Cf-Access-Jwt-Assertion` header the Worker
# actually reads, so your own roster identity and fire-fighter role apply.
#   cloudflared access login https://firefighter.sayandeten.workers.dev
#   cloudflared access token --app=https://firefighter.sayandeten.workers.dev
# Requires WORKER_ORIGIN set and NEXT_PUBLIC_DEMO unset. Short-lived; re-mint
# when the dashboard says "Signed out". The run socket still will not connect.
CF_ACCESS_TOKEN=
