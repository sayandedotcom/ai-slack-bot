# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next/
out/

# production
build
dist

# turbo
.turbo

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# wrangler local secrets — NOT covered by .env*
.dev.vars
.dev.vars.*
# the template is the one variant that is committed; it holds names, never values
!.dev.vars.example
.wrangler

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# personal working notes — deliberately never committed
docs/things-to-remember.md
