# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next/
out/

# production
build
dist

# turbo
.turbo

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# `.env*` anchors at the START of a filename, so it does NOT cover `web.dev.env`
# or anything else that merely ENDS in .env — which is exactly the shape
# Infisical's "download secrets" button produces. Three such files were sitting
# untracked in the repo root on 2026-08-14; one `git add -A` would have
# committed a customer's dev credentials.
*.env
!*.env.example

# wrangler local secrets — NOT covered by .env*
.dev.vars
.dev.vars.*
# the template is the one variant that is committed; it holds names, never values
!.dev.vars.example
.wrangler

# Build-time secrets for the sandbox image (BuildKit --secret sources).
# Not Worker secrets: these are consumed by `docker build`, never by the
# runtime, so they deliberately do not live in .dev.vars.
.build-secrets
.build-secrets.*
!.build-secrets.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# personal working notes — deliberately never committed
docs/things-to-remember.md
