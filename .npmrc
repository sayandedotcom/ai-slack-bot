# Fail the install on the wrong Node rather than at a confusing runtime error
# much later. package.json#engines is ">=22.20.0" and .nvmrc pins 22.20.0;
# without this line the engines field is documentation that nothing reads.
engine-strict=true

# Prefer a workspace package over a registry package of the same name.
# Everything here already uses the `workspace:*` protocol explicitly, so this
# is a guard against a future dependency added without it.
prefer-workspace-packages=true
