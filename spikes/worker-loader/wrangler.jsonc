{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "firefighter-spike-worker-loader",
  "main": "src/index.ts",

  // Global constraint from 00-roadmap.md — do not drift these two.
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // The entire Worker Loader config surface. Confirmed verbatim against
  // inspired-from-ronit.md §9 and agent-os/apps/kernel/wrangler.jsonc.
  "worker_loaders": [{ "binding": "LOADER" }],

  // Task 7 runs the injection from inside a DO, because ctx.exports lives on
  // DurableObjectState and Phase 09 loads isolates from RunDO.
  "durable_objects": {
    "bindings": [{ "name": "SPIKE_DO", "class_name": "SpikeDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SpikeDO"] }],

  "observability": { "enabled": true }
}
