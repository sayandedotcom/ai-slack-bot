{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",

  // ---------------------------------------------------------------- scope
  //
  // Biome 2.x removed `files.ignore`. Exclusions are NEGATED globs inside
  // `includes`, and order matters: the leading `**` pulls everything in and
  // each `!` carves something back out.
  //
  // Every exclusion below is load-bearing, not tidiness.
  "files": {
    // A staged .md or .sql handed to `biome check --staged` is a file type
    // Biome cannot parse. Without this, the husky pre-commit hook errors on
    // every commit that touches a doc.
    "ignoreUnknown": true,
    "includes": [
      "**",

      // Build output and caches.
      "!**/node_modules",
      "!**/dist",
      "!**/.next",
      "!**/.turbo",
      "!**/coverage",
      "!**/.wrangler",
      "!**/.vercel",
      "!pnpm-lock.yaml",

      // THE SECOND CHECKOUT.
      //
      // .claude/worktrees/ holds complete additional checkouts of this
      // repository, node_modules and all. They are kept out of git by
      // .git/info/exclude — which is local to one machine and is NOT a file
      // Biome reads (`vcs.useIgnoreFile` covers .gitignore only). Without
      // this line, `biome check` at the root walks a whole second monorepo.
      "!.claude",

      // GENERATED, AND BYTE-COMPARED.
      //
      // `scripts/generate-capabilities-dts.ts --check` does a literal
      // `existing !== rendered` string comparison against what
      // @cloudflare/codemode emits, which uses four-space indentation and its
      // own line breaks. Reformatting this file once makes
      // `pnpm capabilities:dts:check` fail permanently, and the only repair
      // is to re-run --write, which reverts the formatting, which the
      // formatter then re-applies. Do not remove this line.
      "!apps/worker/src/capabilities/generated",

      // GENERATED by `wrangler types`. Regenerated wholesale by
      // `pnpm cf-typegen`, so formatting it is churn the next regeneration
      // discards. It also carries `// prettier-ignore` pragmas Biome does not
      // honour.
      "!apps/worker/worker-configuration.d.ts",

      // Frozen phase-00 spikes. Each is a self-contained mini-repo with its
      // own lockfile and wrangler.jsonc, deliberately outside the workspace
      // globs. Historical evidence, not maintained code. Still covered by
      // check-text-files.mjs and .gitattributes.
      "!spikes"
    ]
  },

  // Honour .gitignore, so dist/, .env* and .dev.vars need no duplication
  // above. Note this does NOT read .git/info/exclude, which is exactly why
  // .claude/** is listed explicitly.
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },

  // ------------------------------------------------------------ formatter
  //
  // Maps the retired .prettierrc one-for-one, with a single deliberate
  // inversion: `semi: false` becomes `semicolons: "always"`.
  //
  // The old setting described packages/ui, the only place prettier had ever
  // run. apps/worker and apps/dashboard were written WITH semicolons and
  // prettier never touched them. Matching the config to the majority of the
  // code makes the one-time reformat rewrite ~18 files in packages/ui instead
  // of every file everywhere else.
  //
  // lineWidth 80 is retained and is not arbitrary: measured across the
  // tracked app and ui sources, the median line is 30 characters and the 90th
  // percentile is 79. The code was already written to 80.
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "lineEnding": "lf",
    // Keep this file the single source of truth. .editorconfig exists for
    // editors and for the types Biome cannot handle (.md, .sql, .sh); it
    // declares no max_line_length so it cannot fight the value above.
    "useEditorconfig": false
  },

  "javascript": {
    "formatter": {
      "semicolons": "always",
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "trailingCommas": "es5",
      "arrowParentheses": "always",
      "bracketSpacing": true,
      "bracketSameLine": false,
      "quoteProperties": "asNeeded"
    }
  },

  "json": {
    "formatter": {
      "enabled": true,
      "trailingCommas": "none"
    }
  },

  "css": {
    "formatter": { "enabled": true },
    "parser": {
      // packages/ui/src/styles/globals.css is Tailwind v4 CSS-first: @theme,
      // @utility, @custom-variant. Biome's CSS parser needs this to accept
      // them rather than reporting syntax errors.
      "tailwindDirectives": true
    }
  },

  // Experimental in 2.x, and there is exactly one tracked .html file
  // (apps/dashboard/index.html, the Vite entry). Not worth the risk.
  "html": { "formatter": { "enabled": false } },

  // --------------------------------------------------------------- linter
  //
  // Starting posture: Biome's `recommended` preset, with the rules this
  // repository violates in bulk demoted to "warn" rather than switched off.
  //
  // "warn" is the ratchet. `biome ci` exits non-zero on ERRORS only — warnings
  // need --error-on-warnings — so the count stays visible in every CI log and
  // shrinks deliberately, while the gate is green from day one.
  //
  // Each demotion carries its measured count. Re-measure before promoting.
  //
  // `preset` rather than the older `"recommended": true`, which 2.5.10 reports
  // as DEPRECATED and drops in the next major.
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",

      "suspicious": {
        // MEASURED, not assumed: `noExplicitAny` fires ZERO times across the
        // 233 linted files, so it stays at `recommended`'s error level rather
        // than being demoted. The `: any` / `as any` sites in this repository
        // are all in test files (turned off in the override below) or in the
        // generated declarations, which are excluded from Biome entirely.
        //
        // Only ONE rule is demoted, and it names its single site:
        //
        // apps/worker/src/api/approvals.ts:273 declares `let result;` and
        // assigns it inside a try/catch. The fix is a type annotation, which
        // means pinning down `decideApproval`'s return type — a real, if
        // small, change on the approval path, and not something a tooling
        // commit should make. Left as a visible warning to be fixed
        // deliberately. Measured count: 1.
        "noImplicitAnyLet": "warn"
      },

      "nursery": {
        // Tailwind class sorting, replacing prettier-plugin-tailwindcss.
        //
        // NOT equivalent: Biome cannot read a stylesheet, so the retired
        // `tailwindStylesheet` pointing at packages/ui/src/styles/globals.css
        // has no counterpart, and Tailwind v4 @theme tokens sort as unknown.
        //
        // NURSERY means the ordering heuristic can change between Biome
        // minors. That is why @biomejs/biome is pinned EXACT in package.json
        // and ignored by Dependabot: an ordering change must arrive as a
        // deliberate bump, never as a surprise diff on an unrelated PR.
        //
        // "warn" so `pnpm format` sorts, while `pnpm lint` never fails on it.
        // className and class are sorted by default; only extras are listed.
        "useSortedClasses": {
          "level": "warn",
          "fix": "safe",
          "options": {
            "functions": ["cn", "cva", "clsx", "twMerge"]
          }
        }
      }
    }
  },

  // Import sorting. Applied in its OWN commit, after the formatting commit,
  // so that a reorder which changes module side-effect order is reviewable on
  // its own diff.
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },

  "overrides": [
    {
      // turbo.json is JSONC by turbo's own documentation, and this repo's
      // house style is heavily-commented config. Biome would otherwise reject
      // comments in a file whose extension is plain .json.
      "includes": [
        "turbo.json",
        "**/tsconfig*.json",
        ".vscode/*.json",
        "**/*.jsonc"
      ],
      "json": {
        "parser": { "allowComments": true, "allowTrailingCommas": false }
      }
    },
    {
      // The worker and dashboard suites. Test code legitimately reaches for
      // `any` when stubbing a binding, and asserts non-null on fixtures it
      // just created.
      "includes": ["apps/*/test/**", "**/*.test.ts", "**/*.test.tsx"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off",
            // capabilities-effects.test.ts:93 uses `(n += 1)` inside an
            // object literal to count invocations of a stubbed executor.
            // Idiomatic in a test; confusing in production code, where the
            // rule stays on.
            "noAssignInExpressions": "off"
          },
          "style": { "noNonNullAssertion": "off" }
        }
      }
    },
    {
      // Build and ops scripts are Node, not workerd, and legitimately use
      // console and process.
      "includes": ["apps/worker/scripts/**", "*.mjs", "*.cjs"],
      "linter": {
        "rules": { "suspicious": { "noConsole": "off" } }
      }
    },
    {
      // THE ONE `!important` IN THE REPOSITORY, and it is load-bearing.
      //
      // apps/web/app/globals.css carries the prefers-reduced-motion reset,
      // whose whole job is to beat utility classes and inline styles it cannot
      // enumerate — `animate-ping` on the live-run dot among them. An
      // accessibility preference the reader set at the OS level outranks any
      // of them, so the declarations have to win the cascade outright.
      //
      // Scoped to the file and the rule rather than suppressed inline: four
      // identical `biome-ignore` comments inside a four-line block is worse to
      // read than the block itself, and this is never going to shrink, so it
      // does not belong in the warn-level ratchet either.
      "includes": ["apps/web/app/globals.css"],
      "linter": {
        "rules": { "complexity": { "noImportantStyles": "off" } }
      }
    }
  ]
}
